<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>NaSeqMen.Nodes.Controls</RootNamespace>
    <AssemblyName>NaSeqMen.Nodes.Controls</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NaSeqMen.Core\NaSeqMen.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="locales\**\*.*" />
    <None Include="locales\**\*.*" CopyToOutputDirectory="PreserveNewest" Link="locales\$(MSBuildProjectName)\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="locales\**\*.*" LogicalName="locales/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
